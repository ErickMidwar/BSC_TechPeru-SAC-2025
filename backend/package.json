{
  "name": "bsc-techperu-backend",
  "version": "1.1.0",
  "description": "Backend API para BSC TechPeru SAC 2025 - Balanced Scorecard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
